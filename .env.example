# Teacher-LLM credentials. Never commit a real .env (it is gitignored).
# Get a key at https://openrouter.ai/keys

OPENROUTER_API_KEY=

# OpenRouter model id, e.g. anthropic/claude-sonnet-4.5, openai/gpt-4.1-mini,
# google/gemini-2.5-flash, qwen/qwen-2.5-72b-instruct.
# Which one to use is decided by the benchmark, not by guessing.
TEACHER_MODEL=

# Optional attribution headers. The title only has an effect alongside a referer.
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# Hosted Xiaomi MiMo endpoint (see configs/models.yaml -> endpoints.xiaomi).
# Base URL must be the full chat-completions path, e.g.
#   https://<host>/v1/chat/completions
XIAOMI_BASE_URL=
XIAOMI_API_KEY=
